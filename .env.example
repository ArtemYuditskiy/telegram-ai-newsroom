# Generate with: uv run telegram-ai-newsroom web hash-password
# Keep the single quotes around the Argon2id hash in .env.
# NEWSROOM_ADMIN_HASH='$argon2id$...'

# Required for live Telegram delivery. Start with a private test channel.
# NEWSROOM_TELEGRAM_TOKEN=
# NEWSROOM_TELEGRAM_CHAT_ID=

# Optional container settings.
# NEWSROOM_WEB_PORT=8000
# NEWSROOM_PROFILES=/app/evals/gemini-flash-lite.json
# GEMINI_API_KEY=
